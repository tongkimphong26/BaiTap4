@model BaiTapBuoi4.Models.LoginModel

<div class="login-container">
    <h2>Đăng nhập</h2>

    <form method="post">

        <div class="form-group">
            <label>Username</label>
            <input type="text" name="Username" />
        </div>

        <div class="form-group">
            <label>Password</label>
            <input type="password" name="Password" />
        </div>

        <button type="submit">Đăng nhập</button>

    </form>
</div>

<style>
    .login-container {
        width: 400px;
        margin: 50px auto;
    }

    .login-container h2 {
        text-align: center;
        margin-bottom: 25px;
    }

    .form-group {
        display: flex;
        align-items: center;
        margin-bottom: 15px;
    }

    .form-group label {
        width: 100px;
        font-size: 18px;
    }

    .form-group input {
        flex: 1;
        height: 35px;
        padding: 5px 10px;
        box-sizing: border-box;
    }

    button {
        margin-left: 100px;
        padding: 8px 15px;
        font-size: 16px;
        cursor: pointer;
    }
</style>